// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

#include? "Secrets.xcconfig"

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = AIAssistantApp
PRODUCT_DISPLAY_NAME = AI Assistant
PRODUCT_BUNDLE_IDENTIFIER = dev.pi.ios.aiaassistantapp
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.4

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_PIDefaultProvider = $(PI_DEFAULT_PROVIDER)
INFOPLIST_KEY_PIModelScopeName = $(PI_MODELSCOPE_NAME)
INFOPLIST_KEY_PIModelScopeAPIKey = $(PI_MODELSCOPE_API_KEY)
INFOPLIST_KEY_PIModelScopeBaseURL = $(PI_MODELSCOPE_BASE_URL)
INFOPLIST_KEY_PIModelScopeDefaultModel = $(PI_MODELSCOPE_DEFAULT_MODEL)
INFOPLIST_KEY_PIKimiName = $(PI_KIMI_NAME)
INFOPLIST_KEY_PIKimiAPIKey = $(PI_KIMI_API_KEY)
INFOPLIST_KEY_PIKimiBaseURL = $(PI_KIMI_BASE_URL)
INFOPLIST_KEY_PIKimiDefaultModel = $(PI_KIMI_DEFAULT_MODEL)

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/AIAssistantApp.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/AIAssistantApp.entitlements
